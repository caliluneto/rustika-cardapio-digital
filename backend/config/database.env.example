# MODELO SEM CREDENCIAIS REAIS.
# Copie o conteúdo abaixo para a pasta local protegida fora do OneDrive:
#   %LOCALAPPDATA%\CardapioDigital\secrets\
# Use um arquivo por perfil: app-dev.env, app-test.env,
# migrate-dev.env e migrate-test.env.
# Substitua SUBSTITUA_PELA_SENHA_URLENCODED pela senha real, percent-encoded.
# NÃO salve este modelo preenchido dentro do workspace.

# app-dev.env
DATABASE_URL="postgresql://cardapio_dev_app:SUBSTITUA_PELA_SENHA_URLENCODED@127.0.0.1:5432/cardapio_digital_dev?schema=public&sslmode=disable&connection_limit=5&connect_timeout=10"

# app-test.env
DATABASE_URL="postgresql://cardapio_test_app:SUBSTITUA_PELA_SENHA_URLENCODED@127.0.0.1:5432/cardapio_digital_test?schema=public&sslmode=disable&connection_limit=5&connect_timeout=10"

# migrate-dev.env
DATABASE_URL="postgresql://cardapio_migrator:SUBSTITUA_PELA_SENHA_URLENCODED@127.0.0.1:5432/cardapio_digital_dev?schema=public&sslmode=disable&connect_timeout=10"
SHADOW_DATABASE_URL="postgresql://cardapio_migrator:SUBSTITUA_PELA_SENHA_URLENCODED@127.0.0.1:5432/cardapio_digital_shadow?schema=public&sslmode=disable&connect_timeout=10"

# migrate-test.env
DATABASE_URL="postgresql://cardapio_migrator:SUBSTITUA_PELA_SENHA_URLENCODED@127.0.0.1:5432/cardapio_digital_test?schema=public&sslmode=disable&connect_timeout=10"
SHADOW_DATABASE_URL="postgresql://cardapio_migrator:SUBSTITUA_PELA_SENHA_URLENCODED@127.0.0.1:5432/cardapio_digital_shadow?schema=public&sslmode=disable&connect_timeout=10"
