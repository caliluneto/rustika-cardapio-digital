# EXEMPLO sem valores reais. Arquivo bootstrap-homolog.env na pasta de segredos própria da homologação (chmod 600).
# Usado somente por "npm run homolog:bootstrap-admin". A role só tem login durante a janela de bootstrap; remova o arquivo depois.
DATABASE_URL="postgresql://cardapio_homolog_bootstrap:SENHA_URLENCODED_SUBSTITUA@db-homolog.exemplo.invalid:5432/cardapio_digital_homolog?schema=public&sslmode=verify-full"
EXPECTED_DATABASE_HOST="db-homolog.exemplo.invalid"
# UUID impresso pelo script 01-cluster-roles.sql (marca do cluster dedicado). Obrigatorio.
EXPECTED_CLUSTER_ID="00000000-0000-4000-8000-000000000000"
