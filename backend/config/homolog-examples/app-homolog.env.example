# EXEMPLO sem valores reais. Copie para a pasta de segredos PRÓPRIA da homologação (CARDAPIO_SECRETS_DIR),
# fora do repositório e do OneDrive, com o nome app-homolog.env e permissão 600. Nunca versionar o arquivo real.
# Senha: única, >= 24 caracteres, gerada em gerenciador de senhas, URL-encoded.
# O host deve ser remoto (nunca localhost/127.0.0.1) e o TLS é obrigatório.
DATABASE_URL="postgresql://cardapio_homolog_app:SENHA_URLENCODED_SUBSTITUA@db-homolog.exemplo.invalid:5432/cardapio_digital_homolog?schema=public&sslmode=verify-full"
EXPECTED_DATABASE_HOST="db-homolog.exemplo.invalid"
# UUID impresso pelo script 01-cluster-roles.sql (marca do cluster dedicado). Obrigatorio.
EXPECTED_CLUSTER_ID="00000000-0000-4000-8000-000000000000"
