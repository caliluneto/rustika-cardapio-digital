# EXEMPLO sem valores reais. TRANSITORIO: usado somente por "npm run homolog:replay:status|deploy", antes da renomeacao.
# Aponta para o banco de replay cardapio_digital_test DO CLUSTER DEDICADO DE HOMOLOGACAO (nunca o de Dev/Test local) com a role legada
# cardapio_migrator exigida pelas migrations historicas. Apos 04-finalize-rename.sql este perfil deixa de funcionar e deve ser apagado.
# Mesmo host e mesmo EXPECTED_CLUSTER_ID dos demais perfis; TLS obrigatorio; pasta de segredos propria (CARDAPIO_SECRETS_DIR).
DATABASE_URL="postgresql://cardapio_migrator:SENHA_URLENCODED_SUBSTITUA@db-homolog.exemplo.invalid:5432/cardapio_digital_test?schema=public&sslmode=verify-full"
EXPECTED_DATABASE_HOST="db-homolog.exemplo.invalid"
EXPECTED_CLUSTER_ID="00000000-0000-4000-8000-000000000000"
