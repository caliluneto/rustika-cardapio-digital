# EXEMPLO sem valores reais (3D.5.3-C.5 / Fase G).
# Para execução local/supervisionada com CARDAPIO_SECRETS_SOURCE=file, copie para a pasta de segredos
# própria da homologação (CARDAPIO_SECRETS_DIR), fora do repositório e do OneDrive, com o nome
# app-homolog-neon.env e permissão 600. Nunca versionar o arquivo real.
# No Render Free (CARDAPIO_SECRETS_SOURCE=env), use as variáveis prefixadas RUSTIKA_HOMOLOG_* (ver render.yaml).
# Endpoint deve ser DIRETO do Neon (sem sufixo -pooler), com TLS estrito e usuário de runtime (cardapio_homolog_app).
DATABASE_URL="postgresql://cardapio_homolog_app:SENHA_URLENCODED_SUBSTITUA@ep-exemplo-direto-000000.sa-east-1.aws.neon.tech/cardapio_digital_homolog?schema=public&sslmode=require&sslaccept=strict&channel_binding=require"
EXPECTED_DATABASE_HOST="ep-exemplo-direto-000000.sa-east-1.aws.neon.tech"
EXPECTED_CLUSTER_ID="00000000-0000-4000-8000-000000000000"
EXPECTED_PROJECT_ID="exemplo-projeto-00000000"
