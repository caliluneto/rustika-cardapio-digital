# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP da API (não use a mesma porta do frontend)
PORT=4000

# Origem exata autorizada a consumir a API (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Perfil de banco usado pelo backend em execução.
# Valores permitidos: app-dev | app-test
# Perfis migrate-* são rejeitados pelo backend.
DB_PROFILE=app-dev

# Este arquivo NÃO contém credenciais.
# As URLs de conexão ficam em uma pasta local protegida, fora do OneDrive:
#   %LOCALAPPDATA%\CardapioDigital\secrets\<perfil>.env
# Consulte o README e backend/config/database.env.example.
#
# Opcional: sobrescrever a pasta de segredos (nunca use caminho dentro do OneDrive
# ou dentro do workspace do projeto).
# CARDAPIO_SECRETS_DIR=C:\Users\<usuario>\AppData\Local\CardapioDigital\secrets
