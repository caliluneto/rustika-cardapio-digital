generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum OrderStatus {
  RECEIVED
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum ProductAvailability {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE

  @@map("product_availability")
}

enum ComandaStatus {
  OPEN
  CLOSED
  CANCELLED

  @@map("comanda_status")
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  statusChanges OrderStatusHistory[] @relation("AdminStatusChanges")
  invitationsIssued ComandaInvitation[] @relation("IssuedInvitations")

  @@map("admins")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  publicKey    String?  @unique @map("public_key") @db.VarChar(64)
  name         String   @unique
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([isActive, displayOrder])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  publicKey   String?  @unique @map("public_key") @db.VarChar(80)
  sourceCode  String?  @unique @map("source_code") @db.VarChar(64)
  sourceName  String?  @map("source_name")
  sourceGroup String?  @map("source_group")
  descriptionSource String? @map("description_source")
  imageAlt    String?  @map("image_alt")
  availabilityState ProductAvailability @default(UNKNOWN) @map("availability_state")
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  description String?
  ingredients String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive, isAvailable])
  @@index([isActive, availabilityState])
  @@map("products")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       Int         @unique @default(autoincrement()) @map("order_number")
  trackingTokenHash String?     @unique @map("tracking_token_hash") @db.Char(64)
  idempotencyKey    String      @unique @map("idempotency_key")
  requestDigest     String      @map("request_digest") @db.Char(64)
  comandaId         String      @map("comanda_id") @db.Uuid
  sessionId         String      @map("session_id") @db.Uuid
  customerName      String?     @map("customer_name")
  customerPhone     String?     @map("customer_phone")
  tableOrReference  String?     @map("table_or_reference")
  notes             String?
  status            OrderStatus @default(RECEIVED)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(10, 2)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  comanda       Comanda         @relation("ComandaOrders", fields: [comandaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session       ComandaSession  @relation("SessionOrders", fields: [sessionId, comandaId], references: [id, comandaId], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt])
  @@index([sessionId, createdAt, id])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  productNameSnapshot String  @map("product_name_snapshot")
  productPublicKeySnapshot String? @map("product_public_key_snapshot") @db.VarChar(80)
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity            Int
  subtotal            Decimal @db.Decimal(10, 2)
  notes               String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  fromStatus       OrderStatus? @map("from_status")
  toStatus         OrderStatus  @map("to_status")
  changedByAdminId String?      @map("changed_by_admin_id") @db.Uuid
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order          Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedByAdmin Admin? @relation("AdminStatusChanges", fields: [changedByAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId, createdAt])
  @@index([changedByAdminId])
  @@map("order_status_history")
}

model Comanda {
  id       String        @id @default(uuid()) @db.Uuid
  number   String        @unique @db.VarChar(6)
  status   ComandaStatus @default(OPEN)
  openedAt DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt DateTime?     @map("closed_at") @db.Timestamptz(6)

  invitations ComandaInvitation[] @relation("ComandaInvitations")
  sessions    ComandaSession[]    @relation("ComandaSessions")
  orders      Order[]             @relation("ComandaOrders")

  @@map("comandas")
}

model ComandaInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  comandaId       String    @map("comanda_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  issuedByAdminId String    @map("issued_by_admin_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  comanda Comanda         @relation("ComandaInvitations", fields: [comandaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuer  Admin           @relation("IssuedInvitations", fields: [issuedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session ComandaSession? @relation("InviteSession")

  @@unique([id, comandaId])
  @@index([comandaId, expiresAt])
  @@index([issuedByAdminId])
  @@map("comanda_invitations")
}

model ComandaSession {
  id             String    @id @default(uuid()) @db.Uuid
  comandaId      String    @map("comanda_id") @db.Uuid
  invitationId   String    @unique @map("invitation_id") @db.Uuid
  credentialHash String    @unique @map("credential_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  comanda    Comanda           @relation("ComandaSessions", fields: [comandaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitation ComandaInvitation @relation("InviteSession", fields: [invitationId, comandaId], references: [id, comandaId], onDelete: Restrict, onUpdate: Restrict)
  orders     Order[]           @relation("SessionOrders")

  @@unique([id, comandaId])
  @@unique([invitationId, comandaId])
  @@index([comandaId, expiresAt])
  @@map("comanda_sessions")
}

