{
  "name": "cardapio-digital-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Cardápio Digital (Fase 1A)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.unit.config.mts",
    "test:watch": "vitest",
    "test:integration:db": "vitest run --config vitest.integration.config.mts",
    "test:integration:db:cleanup": "tsx tests/integration-db/cleanup-stale.ts",
    "e2e:teardown": "tsx tests/integration-db/e2e/run-teardown.ts",
    "e2e:cleanup-legacy": "tsx tests/integration-db/e2e/cleanup-legacy.ts",
    "e2e:inspect": "tsx scripts/inspect-e2e-state.ts",
    "e2e:validate-state": "tsx scripts/validate-e2e-state.ts",
    "secrets:audit": "tsx scripts/audit-secrets.ts",
    "db:validate": "tsx scripts/prisma-run.ts migrate-dev validate",
    "db:generate": "tsx scripts/prisma-run.ts migrate-dev generate",
    "db:validate:app": "tsx scripts/prisma-run.ts app-dev validate",
    "db:generate:app": "tsx scripts/prisma-run.ts app-dev generate",
    "db:migrate:status:test": "tsx scripts/prisma-run.ts migrate-test migrate status",
    "db:migrate:deploy:test": "tsx scripts/prisma-run.ts migrate-test migrate deploy"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
